# Copiez ce fichier en ".env" et remplissez de vraies valeurs.
# NE JAMAIS committer le fichier ".env" réel dans Git.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite:///./nexus.db

# Générez une vraie valeur avec : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-real-random-secret-before-deploying

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Domaines exacts autorisés à appeler l'API en production (séparés par des
# virgules). Laissé vide = aucune requête navigateur n'est autorisée.
# Exemple : CORS_ALLOWED_ORIGINS=https://nexus-platform.com,https://app.nexus-platform.com
CORS_ALLOWED_ORIGINS=

# Clé Anthropic (Claude) qui active réellement Nexus AI. Sans cette clé,
# le module reste fonctionnel mais répond en mode démonstration (écho),
# sans intelligence artificielle réelle. Obtenez une clé sur
# https://console.anthropic.com — ne l'exposez JAMAIS au frontend ni aux
# utilisateurs (voir modules/ai_assistant/provider.py : le nom du
# fournisseur n'apparaît nulle part côté utilisateur).
AI_PROVIDER_API_KEY=

# Modèle Anthropic utilisé par Nexus AI. Changez cette valeur pour changer
# de modèle sans toucher au code.
AI_MODEL=claude-sonnet-5

# Quel moteur utiliser pour Nexus AI :
#   auto      (défaut) - Anthropic si une clé est renseignée ci-dessus, sinon écho
#   ollama    - GRATUIT : modèle exécuté sur votre ordinateur via https://ollama.com,
#               aucune clé, aucun coût, aucune donnée envoyée à l'extérieur.
#               Installez Ollama, faites "ollama pull llama3.2", puis mettez
#               AI_ENGINE=ollama ici (voir chapitre 12 du manuel officiel).
#   anthropic - force l'API Anthropic (nécessite AI_PROVIDER_API_KEY)
#   echo      - force le mode démonstration (aucun appel réseau)
AI_ENGINE=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Stockage des fichiers du Studio (images/vidéos importées, vidéos
# rendues). Gratuit : reste sur le disque de votre serveur. En
# production, pointez vers un disque persistant (voir deployment/docker-compose.yml,
# volume "nexus_media").
MEDIA_STORAGE_PATH=./media
MEDIA_MAX_UPLOAD_MB=100

# Votre email personnel : le compte qui s'inscrit (ou se reconnecte) avec
# CET email exact obtient automatiquement un accès premium illimité et
# permanent à toute la plateforme (sauf le Réseau social, gratuit pour tous).
# Ne partagez jamais cette valeur ; changez-la si vous soupçonnez une fuite.
INITIAL_SUPERUSER_EMAIL=votre-email@example.com

# --- Fournisseurs de paiement (à activer quand vous en branchez un réel) ---
# Le module Paiements n'appelle actuellement aucun fournisseur (voir
# modules/payments/provider.py) : ces variables n'existent pas encore
# ailleurs dans le code. Elles sont indiquées ici pour que, le jour où
# vous implémentez MTN MoMo / Orange Money / un processeur carte, la clé
# aille directement dans .env et jamais en dur dans provider.py.
# MTN_MOMO_API_KEY=
# MTN_MOMO_API_SECRET=
# ORANGE_MONEY_API_KEY=
# ORANGE_MONEY_API_SECRET=
# CARD_PROCESSOR_SECRET_KEY=
# PAYMENT_WEBHOOK_SIGNING_SECRET=
